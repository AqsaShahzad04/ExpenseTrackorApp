<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ExpenseTrackorApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Theme.ExpenseTrackorApp" parent="Base.Theme.ExpenseTrackorApp" />
    <style name="fabCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/RoundedBottomSheetModal</item>
    </style>

    <style name="RoundedBottomSheetModal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/cream</item>
        <item name="android:background">@drawable/bg_bottom_sheet</item>

    </style>


    <!-- Selectable filter/sort pill. Background swapped in code on tap. -->
    <style name="FilterPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textColor">#1A1612</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_pill_range_unselected</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>