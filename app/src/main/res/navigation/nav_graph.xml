<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment"
    xmlns:tools="http://schemas.android.com/tools"
    >


    <fragment
        android:id="@+id/addEditFragment"
        android:name="com.et.expensetrackorapp.AddEditFragment"
        android:label="Add expense"
        tools:layout="@layout/fragment_add_edit"
         />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.et.expensetrackorapp.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_budget"
            app:destination="@id/budgetFragment" />

        <action
            android:id="@+id/action_home_to_history"
            app:destination="@id/historyFragment" />

    </fragment>
    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.et.expensetrackorapp.BudgetFragment"
        android:label="Budget"
        tools:layout="@layout/fragment_budget" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.et.expensetrackorapp.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" />


</navigation>