<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F1E8"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="90dp">

            <!-- ZONE 1: GREETING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi there,"
                        android:textColor="#7A6F62"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/monthDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fraunces_bold"
                        android:text=" "
                        android:textColor="#1A1612"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnNotifications"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_bell"
                    android:background="@drawable/bg_close_circle" />

            </LinearLayout>

            <!-- ZONE 2: SPENDING CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#1A1612"
                app:cardCornerRadius="26dp"
                app:cardElevation="6dp">

                <!-- FrameLayout lets us STACK the glow behind the content -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- The glow: pinned to top-right, pokes out, card clips it -->
                    <View
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-60dp"
                        android:layout_marginEnd="-60dp"
                        android:background="@drawable/glow_accent" />

                    <!-- The actual card content, sits ON TOP of the glow -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginBottom="0dp"
                                android:text="SPENT THIS MONTH"
                                android:textColor="#A39A8C"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textTxnsLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 txns"
                                android:textColor="#A39A8C"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textSpentThisMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:fontFamily="@font/fraunces_bold"
                            android:text="Rs. 75,769"
                            android:textColor="#FFFCF5"
                            android:textSize="40sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="0dp"/>


                        <!-- Progress bar: grey track holding an orange fill -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_progress_track"
                            android:orientation="horizontal">

                            <!-- Orange fill: weight set in code to be % of the row -->
                            <View
                                android:id="@+id/viewProgressFill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0"
                                android:background="@drawable/bg_progress_fill" />

                            <!-- Empty remainder: takes up the rest -->
                            <View
                                android:id="@+id/viewProgressEmpty"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textPercentOfBudget"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text=""
                                android:textColor="#A39A8C"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#A39A8C"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Three stats row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DAILY AVG"
                                    android:textColor="#A39A8C"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/textDailyAvg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="0"
                                    android:textColor="#FFFCF5"
                                    android:textSize="15sp"
                                    android:fontFamily="@font/fraunces"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TXNS"
                                    android:textColor="#A39A8C"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/textTxns"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="0"
                                    android:textColor="#FFFCF5"
                                    android:fontFamily="@font/fraunces"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CATEGORIES"
                                    android:textColor="#A39A8C"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/textCategories"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="0"
                                    android:fontFamily="@font/fraunces"
                                    android:textColor="#FFFCF5"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- OVER-BUDGET BANNER (shown only when over budget) -->
            <LinearLayout
                android:id="@+id/bannerOverBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_notif_row_danger"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_bell"
                    app:tint="#C73E1D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You're over budget this month."
                    android:textColor="#C73E1D"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ZONE 3: TWO QUICK-ACTION CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFCF5"
                    app:cardCornerRadius="18dp"

                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/cardBudget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_action_icon_tile">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_budget"
                                app:tint="#D9822B" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Budget"
                                android:textColor="#1A1612"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textBudgetValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rs. 80,000"
                                android:textColor="#7A6F62"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#7A6F62"
                            android:textSize="20sp"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFCF5"
                    app:cardCornerRadius="18dp"

                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/cardStatistics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_action_icon_tile">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_stats"
                                app:tint="#D9822B" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Statistics"
                                android:textColor="#1A1612"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="This month"
                                android:textColor="#7A6F62"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#7A6F62"
                            android:textSize="20sp"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ZONE 4: RECENT EXPENSES HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent expenses"
                    android:textColor="#1A1612"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fraunces"
                    />

                <TextView
                    android:id="@+id/textSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="See all >"
                    android:textColor="#E8722C"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="94dp"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#FFFCF5"
                app:strokeWidth="0dp"
               >

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerExpenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"

                    />

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</FrameLayout>